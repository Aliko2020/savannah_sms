# Copy this file to .env and fill in real values. Never commit .env itself.

# Individual pieces used by docker-compose.yml to provision local Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=sms_admin
DB_PASSWORD=change_me
DB_NAME=savannaSms

# Full connection string used by Prisma at runtime (should match the pieces above)
DATABASE_URL=postgresql://sms_admin:change_me@localhost:5432/savannaSms?schema=public

# Express server port
PORT=5000

# Long random string used to sign/verify login JWTs
JWT_SECRET=change_me

# Credentials for the SUPER_ADMIN account created by `npm run seed`
SEED_ADMIN_USERNAME=change_me
SEED_ADMIN_PASSWORD=change_me
